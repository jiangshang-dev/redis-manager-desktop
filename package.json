{
  "name": "redis-manager-desktop",
  "version": "1.0.0",
  "description": "Redis desktop client built with Vue3, TypeScript and Electron",
  "main": "./out/main/index.js",
  "author": "Redis Manager",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
    "build:win": "electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "element-plus": "^2.9.11",
    "pinia": "^3.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  }
}
